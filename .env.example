# Copy to .env — never commit real keys
VER_NETWORK=botTestnet
BOT_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
VER_REGISTRY_LOOKUP=true
# Optional legacy X Layer verified-contract API credentials
# OKX_ACCESS_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
BOT_TESTNET_EXPLORER_API_URL=https://scan.bohr.life/api
BOT_MAINNET_EXPLORER_API_URL=https://scan.botchain.ai/api
BOT_TESTNET_REGISTRY_ADDRESS=0x1763B6958CdD3FF5CebF64c960382ECF3669fFF2
BOT_MAINNET_REGISTRY_ADDRESS=0x51e1BF60223ef60cec511eB1d423FC52b4fF05C7
# Optional X Layer compatibility configuration belongs in a separate deployment environment.
# ALLOWED_ORIGINS=https://wallet.example.com
# DEPLOYER_PRIVATE_KEY=   # local only — never commit
# ATTESTER_PRIVATE_KEY=   # dedicated signer process only
# VER_ENABLE_WRITES=false
# Payment integration is not enabled until a verified BOT Chain payment adapter is configured.
# Transaction preparation has no external LLM fallback (the former flag is ignored).
# Local deployment process only, after explicit approval:
# VER_ENABLE_DEPLOYMENT=false
# VER_DEPLOYMENT_CONFIRM_CHAIN_ID=968
# VER_REGISTRY_CONTRACT=VerRegistryV3
# BOT mainnet deployment uses VER_DEPLOYMENT_CONFIRM_CHAIN_ID=677 and --network botMainnet.
# X Layer remains an explicit compatibility profile via VER_NETWORK=xlayer.
